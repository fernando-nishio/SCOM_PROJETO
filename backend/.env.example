# =====================================================================
#  Freevertio - backend
#  MODELO de configuracao. Copie para .env e preencha com os valores
#  reais:
#
#      cp .env.example .env
#
#  Este arquivo (.env.example) E versionado e deve conter apenas valores
#  de exemplo. O .env NUNCA e versionado - ele esta no .gitignore.
# =====================================================================

# --- Ambiente --------------------------------------------------------
# 'development' libera detalhes tecnicos nas mensagens de erro.
# Qualquer outro valor e tratado como producao.
NODE_ENV=development
PORTA=3000

# --- Banco de dados --------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=freevertio
PGUSER=freevertio
PGPASSWORD=troque_esta_senha

# --- Sessao ----------------------------------------------------------
# Segredo usado para assinar o cookie de sessao. Precisa ser longo e
# aleatorio. Gere o seu com:
#
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# Trocar este valor invalida todas as sessoes abertas.
SESSAO_SEGREDO=gere_um_valor_aleatorio_de_pelo_menos_32_caracteres

# Duracao da sessao em horas.
SESSAO_HORAS=12

# --- Armazenamento ---------------------------------------------------
# Caminho dos arquivos da biblioteca, relativo a raiz do projeto.
# Precisa ficar FORA do diretorio servido como estatico.
CAMINHO_ARMAZENAMENTO=../armazenamento

# Tamanho maximo de upload, em megabytes.
UPLOAD_MAX_MB=20

# --- Conversao -------------------------------------------------------
# Quantas conversoes podem rodar ao mesmo tempo. Use algo proximo do
# numero de nucleos da maquina.
CONVERSAO_CONCORRENCIA=4

# Tamanho maximo da fila de espera. Acima disso o servidor responde 503
# em vez de aceitar trabalho que nao vai conseguir fazer.
CONVERSAO_FILA_MAX=50

# Tempo maximo de uma conversao, em segundos.
CONVERSAO_TIMEOUT_S=30
